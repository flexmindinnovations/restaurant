{
  "name": "@dosa/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical DOSA design tokens (W3C DTCG JSON) and generated CSS, SCSS, TypeScript, JSON and Dart outputs.",
  "type": "module",
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./scss": "./dist/scss/_tokens.scss",
    "./json/*": "./dist/json/*.json",
    ".": "./dist/ts/tokens.ts"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "check": "node scripts/validate.mjs && node scripts/build.mjs --check",
    "report": "node scripts/validate.mjs --report"
  }
}
