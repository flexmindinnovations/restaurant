{
  "$description": "Semantic tokens: light base. Every theme exposes exactly this set of keys. Alpha uses $extensions[\"dosa.alpha\"] on top of a palette reference so no raw colours appear outside primitives.",
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "{color.brand.royal-violet}", "$description": "Brand accent: icons, selection, links on large text, charts. For filled buttons use color.action.primary.bg." },
      "primary-strong": { "$value": "{color.violet.700}", "$description": "Brand violet as text on light surfaces (AA)." },
      "primary-subtle": { "$value": "{color.violet.100}", "$description": "Selected rows, tonal fills." },
      "secondary": { "$value": "{color.brand.saffron}", "$description": "Hospitality highlight. Never as text on light surfaces." },
      "secondary-strong": { "$value": "{color.saffron.700}" },
      "secondary-subtle": { "$value": "{color.saffron.50}" },
      "accent": { "$value": "{color.brand.warm-coral}", "$description": "Appetite accent (customer app promos, food tags)." },
      "accent-subtle": { "$value": "{color.coral.50}" },
      "ink": { "$value": "{color.brand.midnight-ink}" }
    },
    "background": {
      "canvas": { "$value": "{color.brand.pearl}", "$description": "App background behind everything. Grain sits on this layer." },
      "subtle": { "$value": "{color.brand.cloud}", "$description": "Secondary canvas: sidebars, grouped sections." }
    },
    "surface": {
      "primary": { "$value": "{color.white}", "$description": "Default card, table and form surface." },
      "secondary": { "$value": "{color.brand.cloud}", "$description": "Nested surfaces, table header, input fill (filled variant)." },
      "elevated": { "$value": "{color.white}", "$description": "Menus, popovers, dialogs (paired with shadow)." },
      "sunken": { "$value": "{color.ink.100}", "$description": "Wells, code blocks, track of sliders and progress." },
      "inverse": { "$value": "{color.brand.midnight-ink}", "$description": "Tooltips, snackbars." },
      "brand": { "$value": "{color.violet.50}", "$description": "Brand-tinted panel (intelligence modules)." },
      "scrim": { "$value": "{color.ink.950}", "$extensions": { "dosa.alpha": 0.48 }, "$description": "Behind modals and drawers." }
    },
    "text": {
      "primary": { "$value": "{color.brand.midnight-ink}", "$description": "Headings, body, data values." },
      "secondary": { "$value": "{color.brand.slate}", "$description": "Supporting text, labels, metadata (AA on canvas and surfaces)." },
      "tertiary": { "$value": "{color.ink.500}", "$description": "Placeholder-adjacent hints at ≥16px, decorative captions. Not for essential info." },
      "disabled": { "$value": "{color.ink.400}" },
      "inverse": { "$value": "{color.brand.pearl}", "$description": "Text on surface.inverse." },
      "on-primary": { "$value": "{color.white}", "$description": "Text on action.primary.bg." },
      "on-secondary": { "$value": "{color.brand.midnight-ink}", "$description": "Text on Saffron fills (Saffron is too light for white text)." },
      "link": { "$value": "{color.violet.700}" },
      "brand": { "$value": "{color.violet.700}", "$description": "Brand-coloured text (eyebrows, highlights)." }
    },
    "icon": {
      "primary": { "$value": "{color.brand.midnight-ink}" },
      "secondary": { "$value": "{color.brand.slate}" },
      "brand": { "$value": "{color.brand.royal-violet}" },
      "disabled": { "$value": "{color.ink.300}" }
    },
    "border": {
      "subtle": { "$value": "{color.ink.200}", "$extensions": { "dosa.alpha": 0.7 }, "$description": "Dividers, card outlines on canvas." },
      "default": { "$value": "{color.ink.300}", "$description": "Inputs, outlined buttons." },
      "strong": { "$value": "{color.ink.500}", "$description": "Hovered inputs. Meets 3:1 non-text contrast on white." },
      "brand": { "$value": "{color.brand.royal-violet}", "$description": "Selected card, active input." },
      "inverse": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.16 } }
    },
    "focus": {
      "ring": { "$value": "{color.brand.royal-violet}", "$description": "2px ring, 2px offset. 4.06:1 on pearl (≥3:1 non-text)." },
      "ring-halo": { "$value": "{color.brand.royal-violet}", "$extensions": { "dosa.alpha": 0.24 }, "$description": "Optional soft outer halo (4px) for glass surfaces." }
    },
    "action": {
      "primary": {
        "bg": { "$value": "{color.violet.650}", "$description": "Primary button fill. 5.37:1 with white text." },
        "bg-hover": { "$value": "{color.violet.700}" },
        "bg-active": { "$value": "{color.violet.800}" },
        "fg": { "$value": "{color.white}" }
      },
      "secondary": {
        "bg": { "$value": "{color.violet.100}", "$description": "Tonal button." },
        "bg-hover": { "$value": "{color.violet.200}" },
        "bg-active": { "$value": "{color.violet.300}" },
        "fg": { "$value": "{color.violet.800}" }
      },
      "tertiary": {
        "bg": { "$value": "{color.violet.600}", "$extensions": { "dosa.alpha": 0 }, "$description": "Text button: transparent at rest." },
        "bg-hover": { "$value": "{color.violet.600}", "$extensions": { "dosa.alpha": 0.08 } },
        "bg-active": { "$value": "{color.violet.600}", "$extensions": { "dosa.alpha": 0.14 } },
        "fg": { "$value": "{color.violet.700}" }
      },
      "neutral": {
        "bg": { "$value": "{color.white}", "$description": "Outlined/neutral button (paired with border.default)." },
        "bg-hover": { "$value": "{color.ink.50}" },
        "bg-active": { "$value": "{color.ink.100}" },
        "fg": { "$value": "{color.brand.midnight-ink}" }
      },
      "destructive": {
        "bg": { "$value": "{color.coral.700}", "$description": "6.29:1 with white." },
        "bg-hover": { "$value": "{color.coral.800}" },
        "bg-active": { "$value": "{color.coral.900}" },
        "fg": { "$value": "{color.white}" }
      },
      "highlight": {
        "bg": { "$value": "{color.brand.saffron}", "$description": "Hospitality CTA (customer app 'Add to order'). Ink text." },
        "bg-hover": { "$value": "{color.saffron.500}" },
        "bg-active": { "$value": "{color.saffron.600}" },
        "fg": { "$value": "{color.brand.midnight-ink}" }
      }
    },
    "state": {
      "disabled-bg": { "$value": "{color.ink.100}" },
      "disabled-fg": { "$value": "{color.ink.400}" },
      "disabled-border": { "$value": "{color.ink.200}" },
      "hover-overlay": { "$value": "{color.brand.midnight-ink}", "$extensions": { "dosa.alpha": 0.05 } },
      "press-overlay": { "$value": "{color.brand.midnight-ink}", "$extensions": { "dosa.alpha": 0.1 } },
      "selected-bg": { "$value": "{color.violet.50}" }
    },
    "status": {
      "success": {
        "fg": { "$value": "{color.mint.700}", "$description": "Text/icon. 6.4:1 on white." },
        "bg": { "$value": "{color.mint.50}" },
        "border": { "$value": "{color.mint.200}" },
        "solid": { "$value": "{color.mint.650}", "$description": "Filled badge / dot. White text 5.45:1." },
        "on-solid": { "$value": "{color.white}" }
      },
      "warning": {
        "fg": { "$value": "{color.saffron.700}" },
        "bg": { "$value": "{color.saffron.50}" },
        "border": { "$value": "{color.saffron.200}" },
        "solid": { "$value": "{color.brand.saffron}", "$description": "Ink text on solid warning." },
        "on-solid": { "$value": "{color.brand.midnight-ink}" }
      },
      "error": {
        "fg": { "$value": "{color.coral.700}" },
        "bg": { "$value": "{color.coral.50}" },
        "border": { "$value": "{color.coral.200}" },
        "solid": { "$value": "{color.coral.700}" },
        "on-solid": { "$value": "{color.white}" }
      },
      "info": {
        "fg": { "$value": "{color.sky.650}" },
        "bg": { "$value": "{color.sky.50}" },
        "border": { "$value": "{color.sky.200}" },
        "solid": { "$value": "{color.sky.650}" },
        "on-solid": { "$value": "{color.white}" }
      },
      "neutral": {
        "fg": { "$value": "{color.brand.slate}" },
        "bg": { "$value": "{color.ink.100}" },
        "border": { "$value": "{color.ink.200}" },
        "solid": { "$value": "{color.ink.700}" },
        "on-solid": { "$value": "{color.white}" }
      },
      "live": { "$value": "{color.mint.500}", "$description": "Live/online dot." },
      "critical": { "$value": "{color.coral.600}", "$description": "Critical alert dot/accent (non-text)." }
    },
    "order": {
      "$description": "Order lifecycle colours. Shared by every app so a status means the same thing everywhere. Pair colour with an icon and label (never colour alone).",
      "received": { "$value": "{color.sky.600}" },
      "accepted": { "$value": "{color.violet.650}" },
      "preparing": { "$value": "{color.saffron.600}" },
      "ready": { "$value": "{color.mint.650}" },
      "served": { "$value": "{color.ink.600}" },
      "cancelled": { "$value": "{color.coral.700}" },
      "delayed": { "$value": "{color.coral.600}" }
    },
    "chart": {
      "categorical": {
        "1": { "$value": "{color.violet.600}" },
        "2": { "$value": "{color.saffron.400}" },
        "3": { "$value": "{color.mint.500}" },
        "4": { "$value": "{color.coral.500}" },
        "5": { "$value": "{color.sky.500}" },
        "6": { "$value": "{color.rose.400}" },
        "7": { "$value": "{color.ink.700}" },
        "8": { "$value": "{color.violet.300}" }
      },
      "sequential": {
        "1": { "$value": "{color.violet.100}" },
        "2": { "$value": "{color.violet.200}" },
        "3": { "$value": "{color.violet.400}" },
        "4": { "$value": "{color.violet.600}" },
        "5": { "$value": "{color.violet.800}" }
      },
      "diverging": {
        "negative": { "$value": "{color.coral.600}" },
        "neutral": { "$value": "{color.ink.200}" },
        "positive": { "$value": "{color.mint.600}" }
      },
      "grid": { "$value": "{color.ink.200}", "$extensions": { "dosa.alpha": 0.6 } },
      "axis": { "$value": "{color.brand.slate}" }
    },
    "glass": {
      "subtle-tint": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.56 } },
      "standard-tint": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.66 } },
      "premium-tint": { "$value": "{color.brand.pearl}", "$extensions": { "dosa.alpha": 0.6 } },
      "dark-tint": { "$value": "{color.ink.900}", "$extensions": { "dosa.alpha": 0.62 } },
      "border": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.62 }, "$description": "Light edge catching ambient light." },
      "border-dark": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.1 } },
      "highlight": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.8 }, "$description": "1px inner top highlight." },
      "highlight-dark": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.08 } },
      "fallback": { "$value": "{color.white}", "$extensions": { "dosa.alpha": 0.94 }, "$description": "Used when backdrop-filter is unsupported or disabled." },
      "fallback-dark": { "$value": "{color.ink.900}", "$extensions": { "dosa.alpha": 0.96 } }
    },
    "shadow": {
      "key": { "$value": "{color.ink.900}", "$extensions": { "dosa.alpha": 0.08 } },
      "ambient": { "$value": "{color.ink.900}", "$extensions": { "dosa.alpha": 0.05 } },
      "deep": { "$value": "{color.ink.950}", "$extensions": { "dosa.alpha": 0.14 } },
      "brand": { "$value": "{color.violet.600}", "$extensions": { "dosa.alpha": 0.22 }, "$description": "Coloured glow under primary FAB / hero only." }
    },
    "mesh": {
      "$description": "Ambient mesh blobs behind glass. Low-saturation stops of the brand gradients.",
      "a": { "$value": "{color.violet.300}", "$extensions": { "dosa.alpha": 0.42 } },
      "b": { "$value": "{color.saffron.200}", "$extensions": { "dosa.alpha": 0.5 } },
      "c": { "$value": "{color.rose.200}", "$extensions": { "dosa.alpha": 0.38 } },
      "d": { "$value": "{color.mint.200}", "$extensions": { "dosa.alpha": 0.32 } }
    }
  },
  "shadow": {
    "$type": "shadow",
    "0": { "$value": [], "$description": "Flat." },
    "1": { "$value": [
      { "color": "{color.shadow.key}", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
      { "color": "{color.shadow.ambient}", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
    ], "$description": "Resting cards on canvas." },
    "2": { "$value": [
      { "color": "{color.shadow.key}", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "-1px" },
      { "color": "{color.shadow.ambient}", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "-4px" }
    ], "$description": "Hovered cards, sticky bars, glass panels." },
    "3": { "$value": [
      { "color": "{color.shadow.key}", "offsetX": "0px", "offsetY": "4px", "blur": "10px", "spread": "-2px" },
      { "color": "{color.shadow.deep}", "offsetX": "0px", "offsetY": "16px", "blur": "32px", "spread": "-8px" }
    ], "$description": "Menus, popovers, floating toolbars." },
    "4": { "$value": [
      { "color": "{color.shadow.key}", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "-4px" },
      { "color": "{color.shadow.deep}", "offsetX": "0px", "offsetY": "28px", "blur": "56px", "spread": "-12px" }
    ], "$description": "Dialogs, drawers, bottom sheets." },
    "brand": { "$value": [
      { "color": "{color.shadow.brand}", "offsetX": "0px", "offsetY": "10px", "blur": "28px", "spread": "-8px" }
    ], "$description": "Primary FAB and premium glass hero only." }
  },
  "glass": {
    "blur": {
      "$type": "dimension",
      "subtle": { "$value": "12px" },
      "standard": { "$value": "20px" },
      "premium": { "$value": "32px" },
      "dark": { "$value": "24px" }
    },
    "saturate": {
      "$type": "number",
      "subtle": { "$value": 1.4 },
      "standard": { "$value": 1.6 },
      "premium": { "$value": 1.8 },
      "dark": { "$value": 1.3 }
    }
  },
  "gradient": {
    "$type": "gradient",
    "intelligence": { "$value": [
      { "color": "{color.brand.royal-violet}", "position": 0 },
      { "color": "{color.gradient-stop.lavender}", "position": 0.5 },
      { "color": "{color.rose.400}", "position": 1 }
    ], "$extensions": { "dosa.angle": 135 }, "$description": "#7564E8 → #A18AEF → #E9789B. AI insights, forecasts, premium modules." },
    "hospitality": { "$value": [
      { "color": "{color.brand.saffron}", "position": 0 },
      { "color": "{color.brand.warm-coral}", "position": 1 }
    ], "$extensions": { "dosa.angle": 135 }, "$description": "#E9A23B → #E97861. Customer promos, welcome, warmth." },
    "technology": { "$value": [
      { "color": "{color.brand.midnight-ink}", "position": 0 },
      { "color": "{color.gradient-stop.indigo}", "position": 0.55 },
      { "color": "{color.brand.royal-violet}", "position": 1 }
    ], "$extensions": { "dosa.angle": 145 }, "$description": "#202039 → #373C68 → #7564E8. Dark heroes, monitoring headers, splash." },
    "success": { "$value": [
      { "color": "{color.brand.mint}", "position": 0 },
      { "color": "{color.gradient-stop.mint-soft}", "position": 1 }
    ], "$extensions": { "dosa.angle": 135 }, "$description": "#35B99A → #65C9A4. Payment success, order ready." }
  },
  "grain": {
    "opacity": { "$type": "number", "$value": "{opacity.grain-light}" },
    "blend": { "$type": "string", "$value": "multiply", "$description": "CSS mix-blend-mode for the grain layer." }
  }
}
